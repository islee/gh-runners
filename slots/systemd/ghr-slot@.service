# ghr-slot@.service — one slot loop per instance, e.g. ghr-slot@supabase-5.service (Proxmox host).
#
# Template rendered by slots/install-pve.sh (@-delimited placeholders). The instance name is <class>-<n>; the
# loop runs as the unprivileged controller account and reaches root only through the sudoers rule for
# launch-pve (qm is root-only). KillMode=process + TimeoutStopSec mirror the macOS daemon
# (AbandonProcessGroup + ExitTimeOut): SIGTERM goes to the loop alone, which finishes (or releases) its
# job before exiting. CRITICAL: not `mixed` -- that SIGKILLs the root launch-pve the moment the loop
# exits, skipping its EXIT-trap destroy and leaking the job VM (first live stop, 2026-10-21). With
# `process` launch-pve outlives the loop, sees the VM power off and destroys it; the next cycle's
# sweep / leftover check covers anything else. NoNewPrivileges must stay off: sudo is setuid.
[Unit]
Description=ghr runner slot %i
After=network-online.target pve-cluster.service
Wants=network-online.target

[Service]
Type=simple
User=@CTL_USER@
Environment=HOME=@CTL_HOME@
Environment=GHR_STATE_DIR=@STATE_ROOT@/slots
Environment=LAUNCH_USER=root
Environment=LAUNCH_BIN=@LIBEXEC@/launch-pve
ExecStart=@LIBEXEC@/slot-unit %i
Restart=always
RestartSec=30
KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=21700
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
