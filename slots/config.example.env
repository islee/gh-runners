# config.example.env — template for /usr/local/etc/ghr/slots.env (root-owned 0644).
#
# NO SECRETS here: App private keys live in 0400 pem files owned by the role accounts, and
# installation tokens are minted at runtime. Everything org-specific comes from this file;
# nothing is hardcoded in the scripts. Plain KEY=value (sourced by bash; quote values with spaces).

# GitHub org that owns the runners.
ORG=example-org
# Runner group for minted JIT runners (1 = Default).
RUNNER_GROUP_ID=1

# Runner App (role _ghrctl): org "Self-hosted runners: Read & write". Key: RUNNER_APP_KEY.
RUNNER_APP_ID=0
RUNNER_INSTALLATION_ID=0
RUNNER_APP_KEY=/var/db/_ghrctl/runner-app.pem

# State App (role _ghrstate): repo "Variables: Read & write" + org "Self-hosted runners: Read".
# Add repo "Actions: Read" only if you use the ios demand probe (IOS_DEMAND_REPOS below).
STATE_APP_ID=0
STATE_INSTALLATION_ID=0
STATE_APP_KEY=/var/db/_ghrstate/state-app.pem

# Repos that receive the SELF_HOSTED_STATE variable (space or comma separated owner/repo).
CONSUMER_REPOS="example-org/example-repo"

# Labels a minted runner may carry. EMPTY REFUSES EVERYTHING (fail closed). Hosted-runner labels
# (ubuntu-*, macos-*, windows-*) are refused regardless of this list.
ALLOWED_LABELS="ghr-light,ghr-supabase,ghr-ios"

# light class: slot count (hard max 6), labels the runners carry, image pinned immutably:
# LIGHT_IMAGE may be repo@sha256:<digest> OR a local image ID sha256:<64 hex> (the IMAGE_ID
# printed by images/build-light.sh). Tags without a digest are refused.
LIGHT_SLOTS=6
LIGHT_LABELS="ghr-light"
LIGHT_IMAGE=ghcr.io/actions/actions-runner@sha256:REPLACE_WITH_64_HEX_DIGEST

# supabase class (per-job VMs cloned from the golden ghr-supa-golden, one stack per VM).
# SUPABASE_SLOTS=0 disables the class entirely (hard max 3). SUPA_MEM / SUPA_CPUS size each VM.
SUPABASE_SLOTS=0
SUPABASE_LABELS="ghr-supabase"
SUPA_MEM=4GiB
SUPA_CPUS=4

# ios class: ONE Tart macOS VM per job (Xcode builds), cloned from the stopped golden IOS_GOLDEN.
# IOS_SLOTS=0 disables it (0|1; the macOS licence allows 2 VMs per host, memory allows 1). The slot is
# DORMANT -- no runner, no VM -- until the heartbeat sees a queued job labelled IOS_LABELS in one of
# IOS_DEMAND_REPOS (owner/repo list, space or comma separated; empty = never wakes). Then the supabase
# slots numbered above IOS_SUPA_KEEP yield (their per-job VMs are not started), because the 8 GiB macOS
# VM does not fit beside them (24 GiB host: light VM 8 + supabase 4 each + ios 8). The probe needs the
# State App's repo permission "Actions: Read". The probe only looks at `workflow_dispatch` runs, so ios
# workflows MUST be dispatch-only (a push/PR-triggered ios job would never wake the slot).
IOS_SLOTS=0
IOS_LABELS="ghr-ios"
IOS_DEMAND_REPOS=
IOS_SUPA_KEEP=1
# VM sizing: memory in MiB, vCPUs.
IOS_MEM_MB=8192
IOS_CPUS=4
# Egress preflight targets for the ios VM (space/comma separated host:port); ALL must be unreachable
# from inside the guest, unset/empty refuses every job. NOT LAN_PROBE: a Tart NAT guest cannot reach
# the host's own LAN address even with no filtering, so that proves nothing. Pick a LAN device that
# IS reachable when unfiltered, plus the vmnet gateway's sshd (RFC 5737 placeholder below).
# Every target needs a POSITIVE CONTROL: verify from a guest with the pf rules OFF that it is reachable
# (otherwise "blocked" proves nothing). 192.168.64.1:22 only works as one while Remote Login is enabled
# on the host.
IOS_LAN_PROBES="192.0.2.1:443 192.168.64.1:22"
# Golden VM name (images/build-ios.sh) and where the runner lives INSIDE it (default below).
#IOS_GOLDEN=ghr-ios-golden
#IOS_RUNNER_DIR=/Users/admin/actions-runner
# Seconds an ios runner may sit without being online before the pool reads `down` (the macOS VM boots
# for 1-2 minutes first, and the heartbeat needs two marks 60 s apart). Must stay above IOS_BOOT_TIMEOUT (300)
# plus that latency.
#IOS_STUCK_SECS=600

# host:port the pool VM and every light and supabase VM must NOT be able to reach (egress-isolation preflight). Unset = refuse.
LAN_PROBE=192.0.2.1:22

# Remote slots (macOS heartbeat host only): slots of ANOTHER host, as <class>-<n> (space or comma
# separated), e.g. the Proxmox node's supabase slot "supabase-5". The tripwire then accepts their
# runner names, and saturation counts each as one more slot of its class (busy when its runner is busy
# OR offline/absent). They never make the state `down`. n must be above the class's local slot count
# (the Mac may grow to 4 local slots; launch.sh's own cap of 3 does not limit the remote number);
# invalid entries are ignored with a log line. Default empty.
REMOTE_SLOTS=

# ── Proxmox VE host (optional second host; see install-pve.sh / launch-pve.sh). Uncomment and edit on
# THAT host's /usr/local/etc/ghr/slots.env; leave SUPABASE_SLOTS=0 and LIGHT_SLOTS=0 there. The Mac must
# not set PVE_SLOTS. Placeholders below use documentation addresses (RFC 5737).
# Slot numbers this host serves (1..9, space/comma separated); the runner is named ghr-supabase-<n>.
#PVE_SLOTS=5
# Slot VMID = PVE_VMID_BASE + n (here 305); the golden template's VMID must be a different number.
#PVE_VMID_BASE=300
#GOLDEN_VMID=300
# Per-job VM sizing: memory in MiB, vCPUs (shared with SUPA_CPUS above).
#SUPA_MEM_MB=4096
# Static address of each slot's VM (qm --ipconfig0 syntax); one per slot in PVE_SLOTS.
#PVE_IPCONFIG_5="ip=192.0.2.50/24,gw=192.0.2.1"
# Public resolvers (the VM may not reach LAN DNS), space separated.
#PVE_NAMESERVER="1.1.1.1 8.8.8.8"
# Used by the slot-loop unit (set by ghr-slot@.service, shown for reference): the launch script runs
# as root because qm is root-only.
#LAUNCH_USER=root
#LAUNCH_BIN=/usr/local/libexec/ghr/launch-pve
# Runner App key location on that host (install-pve.sh --runner-key puts it here):
#RUNNER_APP_KEY=/var/lib/ghrctl/runner-app.pem
