# config.example.env — template for /usr/local/etc/ghr/slots.env (root-owned 0644).
#
# NO SECRETS here: App private keys live in 0400 pem files owned by the role accounts, and
# installation tokens are minted at runtime. Everything org-specific comes from this file;
# nothing is hardcoded in the scripts. Plain KEY=value (sourced by bash; quote values with spaces).

# GitHub org that owns the runners.
ORG=example-org
# Runner group for minted JIT runners (1 = Default).
RUNNER_GROUP_ID=1

# Runner App (role _ghrctl): org "Self-hosted runners: Read & write". Key: RUNNER_APP_KEY.
RUNNER_APP_ID=0
RUNNER_INSTALLATION_ID=0
RUNNER_APP_KEY=/var/db/_ghrctl/runner-app.pem

# State App (role _ghrstate): repo "Variables: Read & write" + org "Self-hosted runners: Read".
STATE_APP_ID=0
STATE_INSTALLATION_ID=0
STATE_APP_KEY=/var/db/_ghrstate/state-app.pem

# Repos that receive the SELF_HOSTED_STATE variable (space or comma separated owner/repo).
CONSUMER_REPOS="example-org/example-repo"

# Labels a minted runner may carry. EMPTY REFUSES EVERYTHING (fail closed). Hosted-runner labels
# (ubuntu-*, macos-*, windows-*) are refused regardless of this list.
ALLOWED_LABELS="ghr-light"

# light class: slot count (hard max 6), labels the runners carry, image pinned immutably:
# LIGHT_IMAGE may be repo@sha256:<digest> OR a local image ID sha256:<64 hex> (the IMAGE_ID
# printed by images/build-light.sh). Tags without a digest are refused.
LIGHT_SLOTS=6
LIGHT_LABELS="ghr-light"
LIGHT_IMAGE=ghcr.io/actions/actions-runner@sha256:REPLACE_WITH_64_HEX_DIGEST

# host:port the pool VM must NOT be able to reach (egress-isolation preflight). Unset = refuse.
LAN_PROBE=192.0.2.1:22
