# ghr-rescuer config (copy to rescuer.env; the real file is gitignored). No secrets here: the App
# private key is a file mounted at RESCUER_APP_KEY.
RESCUER_APP_ID=123456
RESCUER_INSTALLATION_ID=12345678
RESCUER_APP_KEY=/run/secrets/rescuer-app.pem
# Space-separated owner/repo list; empty = every repo the App installation covers.
REPOS=
LABEL_PREFIX=ghr-
# Rescue a job queued on a LABEL_PREFIX* label longer than this. Keep it above the longest job a
# healthy pool can make another job wait behind (see README "Choosing the timings").
MAX_WAIT_MIN=15
# Seconds between passes; 0 = one pass and exit.
INTERVAL_SEC=300
# Never rescue a run already at this attempt (stops an endless cancel/re-run loop).
MAX_ATTEMPTS=3
DRY_RUN=false

# ── usage ledger (usage.py); it ignores REPOS and covers every repo the App installation covers ──
# First day to backfill while the ledger is empty (UTC, YYYY-MM-DD); required on the first run.
USAGE_SINCE=2026-10-16
# Each pass re-scans this many days before the last clean pass, to catch runs that finish late.
USAGE_LOOKBACK_DAYS=7
# Seconds between passes; 0 = one pass and exit.
USAGE_INTERVAL_SEC=3600
# SQLite file; the compose example mounts ./usage-data at /data.
USAGE_DB=/data/usage.sqlite
# List price per GitHub-hosted minute (Linux 2-core x64) and the plan's free minutes per month (Free = 2000).
RATE_PER_MIN=0.006
INCLUDED_MINUTES=2000
